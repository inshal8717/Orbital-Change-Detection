      "rennes",
      "saclay_e"
    ],
    "val": [
      "abudhabi",
      "aguasclaras",
      "beirut",
      "bercy",
      "paris"
    ],
    "test": [
      "brasilia",
      "chongqing",
      "dubai",
      "lasvegas",
      "milano",
      "montpellier",
      "norcia",
      "rio",
      "saclay_w",
      "valencia"
    ]
  }
}
